{
  "$schema": "../../doc/schemas/sys_config.schema.json",
  "schema_version": 1,
  "app": "microcar",

  // MicroCar状态灯使用LED实例0。
  "application": {
    "status_led_id": 0
  },

  // 外设电气参数由CubeMX管理；这里仅绑定生成的HAL句柄。
  "hal": {
    "can": {
      "instances": [
        // CAN电机总线使用CubeMX生成的CAN1句柄。
        {"id": "can1", "handle": "hcan", "header": "can.h"}
      ]
    },
    "gpio": {},
    "i2c": {
      "instances": [
        // SH1106 OLED使用I2C1（PB8/PB9）。
        {
          "id": "i2c1",
          "handle": "hi2c1",
          "header": "i2c.h"
        },
        // ICM20602使用I2C2（PB10/PB11），400 kHz阻塞收发。
        {
          "id": "i2c2",
          "handle": "hi2c2",
          "header": "i2c.h"
        }
      ]
    },
    "pwm": {
      "instances": [
        // WS2812B使用TIM3通道4，PB1和DMA配置由CubeMX管理。
        {"id": "pwm1", "handle": "htim3", "header": "tim.h", "channel": 4}
      ]
    },
    "spi": {
      "instances": [
        // W25Q16使用SPI1，18 MHz阻塞式全双工通讯。
        {"id": "spi1", "handle": "hspi1", "header": "spi.h"}
      ]
    },
    "uart": {
      "instances": [
        // 调试CLI使用USART1。
        {
          "id": "uart1",
          "handle": "huart1",
          "header": "usart.h"
        }
      ]
    },
    "watchdog": {
      "handle": "hiwdg",
      "header": "iwdg.h"
    }
  },

  "components": {
    // SA0为高时地址是0x69；INT为高有效脉冲，PB0使用上升沿触发并默认下拉。
    "icm20602": {
      "i2c": "i2c2",
      "address": 105,
      "INT": {
        "pin": "PB0",
        "active_level": 1
      }
    },
    // PC13板载LED低电平点亮。
    "led": {
      "instances": [
        {
          "id": 0,
          "gpio": {
            "pin": "PC13",
            "active_level": 0
          }
        }
      ]
    },
    // 电机组件当前使用CAN1，后续可扩展PWM和UART传输类型。
    "motor": {
      "transport": "can",
      "can": "can1"
    },
    // SH1106固定协议参数由OLED组件维护。
    "oled": {
      "i2c": "i2c1"
    },
    // 调试字节流当前使用USART1；波特率必须与CubeMX一致。
    "stream": {
      "name": "debug",
      "uart": "uart1",
      "baud_rate": 921600
    },
    // CLI只绑定流名称，不再直接依赖UART或DMA。
    "uart_cli": {
      "stream": "debug"
    },
    "watchdog": {}
    ,
    // W25Q16容量和4 KB扇区属于器件固定参数，这里只绑定SPI和片选。
    "flash": {
      "w25q16": {
        "spi": "spi1",
        "CS": {"pin": "PA4", "active_level": 0}
      }
    },
    // 当前MicroCar连接8颗WS2812B，数据由TIM3_CH4/PB1 PWM DMA输出。
    "ws2812b": {
      "transport": "pwm_dma",
      "pwm": "pwm1",
      "count": 8
    }
  }
}
