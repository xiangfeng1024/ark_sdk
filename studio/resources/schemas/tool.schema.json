{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool.schema.json",
  "title": "ARK CREW Studio Tool Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "description", "category", "icon", "availability", "parameter_mode", "entrypoint", "check", "progress"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "category": {"type": "string", "minLength": 1},
    "icon": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "default": 100},
    "availability": {"enum": ["active", "planned"]},
    "parameter_mode": {"enum": ["none", "fixed", "dynamic"]},
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "handler"],
      "properties": {
        "kind": {"const": "builtin"},
        "handler": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "args": {"type": "array", "items": {"type": "string"}}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handler", "timeout_ms"],
      "properties": {
        "handler": {"type": "string", "minLength": 1},
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 120000}
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["event", "query", "completion"]},
        "handler": {"type": "string"},
        "interval_ms": {"type": "integer", "minimum": 100, "maximum": 10000}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "type"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "label": {"type": "string"},
          "type": {"enum": ["text", "integer", "boolean", "enum", "file", "directory", "app", "probe", "serial_port"]},
          "required": {"type": "boolean"},
          "default": {},
          "options": {"type": "array"},
          "placeholder": {"type": "string"},
          "description": {"type": "string"},
          "remember": {"type": "boolean"}
        }
      }
    },
    "validators": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "resources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "steps", "effects"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "items": {"type": "string"}},
        "effects": {"type": "array", "items": {"type": "string"}}
      }
    },
    "danger": {"enum": ["safe", "warning", "critical"]},
    "cancellable": {"type": "boolean"},
    "quick": {"type": "boolean"},
    "ui_mode": {"enum": ["task", "serial_terminal"]},
    "test_only": {"type": "boolean"}
  }
}
