{
  "schema_version": 1,
  "id": "project.package",
  "title": "打包独立工程",
  "description": "生成只包含所选依赖且全量编译通过的交付包。",
  "category": "交付",
  "icon": "PackageCheck",
  "order": 220,
  "availability": "active",
  "parameter_mode": "dynamic",
  "entrypoint": {
    "kind": "builtin",
    "handler": "package_project",
    "args": ["--config", "${app_config}", "--output", "${param.output}", "--uv4", "${uv4}"]
  },
  "check": {"handler": "project_package", "timeout_ms": 2500},
  "progress": {"mode": "event"},
  "inputs": [
    {
      "name": "output",
      "label": "交付包输出目录",
      "type": "directory",
      "required": true,
      "default": "",
      "description": "必须是SDK和CubeMX工程之外的现有目录。"
    }
  ],
  "validators": [],
  "resources": ["keil:${project}", "package:${output}"],
  "confirmation": {
    "summary": "将复制当前CubeMX工程和所选SDK依赖，在临时目录全量编译后发布独立交付包。",
    "steps": ["校验DTS与Keil同步状态", "复制精简工程", "重写相对路径", "全量编译验证", "清理临时构建输出并发布"],
    "effects": ["在所选输出目录中新建<cube工程名>_package目录", "不会修改原CubeMX生成源码"]
  },
  "danger": "warning",
  "cancellable": false,
  "quick": false
}
