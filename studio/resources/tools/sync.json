{
  "schema_version": 1,
  "id": "keil.sync",
  "title": "同步Keil",
  "description": "生成DTS运行时数据，并将DTS选中的App、HAL和组件同步到Keil工程。",
  "category": "构建",
  "icon": "RefreshCw",
  "order": 40,
  "availability": "active",
  "parameter_mode": "none",
  "entrypoint": {"kind": "builtin", "handler": "sync"},
  "check": {"handler": "project", "timeout_ms": 5000},
  "progress": {"mode": "event"},
  "inputs": [],
  "validators": ["dts_current", "synced_app"],
  "resources": ["keil:${project}"],
  "confirmation": {
    "summary": "同步会校验当前App DTS、生成只读OF数据，并更新Keil工程中的ARK_SDK源码分组、头文件路径、宏和设备下载配置。",
    "steps": ["解析并校验<app>.dts", "生成ark_dts_generated.h/.c", "按status和compatible解析HAL/组件", "重写Keil ARK_SDK分组并核对已同步App"],
    "effects": ["app/<当前App>/include/ark_dts_generated.h", "app/<当前App>/src/ark_dts_generated.c", "当前工程的.uvprojx与必要的.uvoptx配置"]
  },
  "danger": "warning",
  "cancellable": true,
  "quick": true
}
