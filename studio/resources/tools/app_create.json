{
  "schema_version": 1,
  "id": "project.create_app",
  "title": "新建App",
  "description": "从同版型CubeMX模板创建同名App、DTS和Keil工程，并完成首次同步。",
  "category": "项目",
  "icon": "AppWindow",
  "order": 190,
  "availability": "active",
  "parameter_mode": "dynamic",
  "entrypoint": {
    "kind": "builtin",
    "handler": "app_create",
    "args": [
      "--sdk-root", "${workspace}",
      "--template-config", "${app_config}",
      "--source", "${param.source}",
      "--cube-parent", "${param.cube_parent}",
      "--name", "${param.name}"
    ]
  },
  "check": {
    "handler": "project_create",
    "timeout_ms": 1500
  },
  "progress": {
    "mode": "event"
  },
  "inputs": [
    {
      "name": "source",
      "label": "CubeMX模板工程",
      "type": "directory",
      "required": true,
      "default": "${cube_project}",
      "description": "默认使用当前App对应的同版型CubeMX工程。"
    },
    {
      "name": "cube_parent",
      "label": "CubeMX工程父目录",
      "type": "directory",
      "required": true,
      "default": "${workspace_parent}/ark_stm32_projects",
      "description": "新同名CubeMX工程将创建在该现有目录下。"
    },
    {
      "name": "name",
      "label": "新App统一名称",
      "type": "text",
      "required": true,
      "default": "",
      "placeholder": "c8t6_new_app",
      "description": "必须使用小写<版型前缀>_<项目名>，并同时作为App、DTS、IOC、Keil工程和Target名称。"
    }
  ],
  "validators": [],
  "resources": [
    "app-create:${name}",
    "cube-parent:${cube_parent}"
  ],
  "confirmation": {
    "summary": "将创建一个新的同名App与CubeMX/Keil工程，不修改模板工程。",
    "steps": [
      "检查版型、名称和目标路径",
      "克隆并重命名CubeMX/Keil模板",
      "创建最小DTS和appStartTask源码",
      "生成ark_dts_generated.c/.h",
      "把新App首次同步到新Keil工程"
    ],
    "effects": [
      "在ark_sdk/app下新建App目录",
      "在所选CubeMX父目录下新建同名工程",
      "只修改新建副本，不修改模板和当前App"
    ]
  },
  "danger": "warning",
  "cancellable": false,
  "quick": false
}
