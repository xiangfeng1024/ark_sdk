{
  "schema_version": 1,
  "id": "debug.serial",
  "title": "串口收发监视器",
  "description": "在Studio内嵌终端中启动单会话串口收发，支持文本、GBK和HEX显示。",
  "category": "调试",
  "icon": "Cable",
  "order": 240,
  "availability": "active",
  "parameter_mode": "dynamic",
  "ui_mode": "serial_terminal",
  "entrypoint": {
    "kind": "builtin",
    "handler": "serial_monitor",
    "args": []
  },
  "check": {"handler": "serial_monitor", "timeout_ms": 1500},
  "progress": {"mode": "event"},
  "inputs": [
    {"name": "port", "label": "串口", "type": "text", "required": true, "default": "auto", "placeholder": "auto 或 COM3", "remember": true},
    {"name": "baud", "label": "波特率", "type": "text", "required": true, "default": "auto", "placeholder": "auto（读取当前App DTS）或921600", "remember": true},
    {"name": "send", "label": "启动时发送", "type": "text", "required": false, "default": "", "description": "打开串口后发送一次，工具会自动追加回车换行。", "remember": true}
  ],
  "validators": [],
  "resources": ["serial:${port}"],
  "danger": "safe",
  "cancellable": false,
  "quick": false
}
