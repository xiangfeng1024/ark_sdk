{
  "schema_version": 1,
  "id": "keil.flash.incremental",
  "title": "增量编译并烧录",
  "description": "增量编译成功后使用选定探针烧录、校验并自动运行。",
  "category": "烧录",
  "icon": "Zap",
  "order": 70,
  "availability": "active",
  "parameter_mode": "fixed",
  "entrypoint": {"kind": "builtin", "handler": "flash_incremental"},
  "check": {"handler": "keil_synced_probe", "timeout_ms": 4000},
  "progress": {"mode": "event"},
  "inputs": [
    {"name": "probe", "label": "下载探针", "type": "probe", "default": "dap", "options": ["dap", "stlink"], "required": true}
  ],
  "validators": ["build_output", "flash_complete"],
  "resources": ["keil:${project}", "probe:${probe}"],
  "danger": "safe",
  "cancellable": true,
  "quick": true
}
