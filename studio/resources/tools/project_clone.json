{
  "schema_version": 1,
  "id": "project.clone",
  "title": "克隆CubeMX工程",
  "description": "选择源工程、目标目录和新名称后创建可迁移副本。",
  "category": "项目",
  "icon": "CopyPlus",
  "order": 200,
  "availability": "active",
  "parameter_mode": "dynamic",
  "entrypoint": {
    "kind": "builtin",
    "handler": "project_clone",
    "args": ["clone", "${param.source}", "${param.destination}", "--name", "${param.name}", "--sdk-root", "${workspace}"]
  },
  "check": {"handler": "project_clone", "timeout_ms": 1500},
  "progress": {"mode": "event"},
  "inputs": [
    {
      "name": "source",
      "label": "源CubeMX工程",
      "type": "directory",
      "required": true,
      "default": "${cube_project}"
    },
    {
      "name": "destination",
      "label": "新工程完整路径",
      "type": "directory",
      "required": true,
      "default": "",
      "description": "目标目录必须尚不存在。"
    },
    {
      "name": "name",
      "label": "新工程名",
      "type": "text",
      "required": true,
      "default": "",
      "placeholder": "c8t6_new_project"
    }
  ],
  "validators": [],
  "resources": ["clone:${destination}"],
  "confirmation": {
    "summary": "将在指定新路径创建CubeMX工程副本，并统一修改IOC、Keil工程、Target和SDK相对路径。",
    "steps": ["检查源工程", "复制并过滤构建产物", "统一重命名工程文件和Target", "重写SDK相对路径", "发布新目录"],
    "effects": ["新建目标工程目录", "不修改源工程", "目标目录已存在时拒绝执行"]
  },
  "danger": "warning",
  "cancellable": false,
  "quick": false
}
